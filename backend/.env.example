# Replace all values with independent random secrets. Never commit real values.
# openssl rand -hex 32
RAAHAT_ADMIN_TOKEN=replace-with-at-least-32-random-characters
RAAHAT_TOKEN_SIGNING_KEY=replace-with-a-different-random-secret-of-32-plus-characters
# openssl rand -base64 32; the decoded key must be exactly 32 bytes
RAAHAT_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
RAAHAT_LISTEN_ADDR=:8080
RAAHAT_DATA_FILE=./data/premium-catalog.enc
