<Window x:Class="RaahatVPN.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="راحت وی‌پی‌ان | Raahat VPN" Width="700" Height="790" MinWidth="600" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}" FlowDirection="RightToLeft">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,22"><TextBlock Text="راحت وی‌پی‌ان" FontSize="29" FontWeight="Bold"/><TextBlock Text="Raahat VPN · Windows" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right"/></StackPanel>
<Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
<StackPanel><DockPanel><TextBlock Text="حساب و اشتراک" FontSize="16" FontWeight="SemiBold"/><Button x:Name="SyncButton" Content="بررسی حساب و سرورها" DockPanel.Dock="Left" Click="SyncButton_Click" Padding="14,8"/></DockPanel>
<PasswordBox x:Name="TokenBox" Height="40" Margin="0,14,0,0" Padding="10,6" Background="#0B1425" Foreground="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" FlowDirection="LeftToRight"/>
<TextBlock Text="کد دسترسی حساب را وارد کنید؛ پس از ذخیره با محافظت ویندوز نگهداری می‌شود." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/></StackPanel></Border>
<Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="سرورهای ویژه" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PlanText" Text="حساب هنوز بررسی نشده است" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/></StackPanel>
<ListBox x:Name="ServerList" Grid.Row="1" Background="#0B1425" Foreground="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" SelectionChanged="ServerList_SelectionChanged" DisplayMemberPath="DisplayName" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="3"/></Style></ListBox.ItemContainerStyle></ListBox>
<StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="StatusText" Text="آماده اتصال" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/><TextBlock x:Name="DetailText" Text="برای دریافت فهرست سرورها، حساب خود را بررسی کنید." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/><Button x:Name="ConnectButton" Content="اتصال" FontSize="18" Height="58" Click="ConnectButton_Click"/></StackPanel>
</Grid></Border>
<DockPanel Grid.Row="3" Margin="2,14,2,0"><TextBlock Text="نسخه 1.0.0" Foreground="{StaticResource MutedBrush}" FontSize="11" FlowDirection="LeftToRight"/><TextBlock Text="موتور sing-box 1.14.4" Foreground="{StaticResource MutedBrush}" FontSize="11" DockPanel.Dock="Left" FlowDirection="LeftToRight"/></DockPanel>
</Grid></Window>